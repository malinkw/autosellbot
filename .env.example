# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
BOT__TOKEN=123456:CHANGE_ME
BOT__ADMIN_IDS=[111111111]           # Telegram ID владельцев (list JSON)
BOT__PARSE_MODE=HTML
BOT__DROP_PENDING_UPDATES=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB__HOST=postgres
DB__PORT=5432
DB__USER=autosale
DB__PASSWORD=autosale
DB__NAME=autosale
DB__ECHO=false
DB__POOL_SIZE=20
DB__MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=

# ---------------------------------------------------------------------------
# Приложение
# ---------------------------------------------------------------------------
APP__ENV=production                  # production | development | testing
APP__LOG_LEVEL=INFO
APP__LOG_DIR=app/logs
APP__CURRENCY=RUB
APP__CURRENCY_SYMBOL=₽
APP__PAGE_SIZE=8
APP__DISPUTE_WINDOW_HOURS=24
APP__RATE_LIMIT_PER_SECOND=3
APP__BACKUP_DIR=backups
APP__BACKUP_CRON=0 4 * * *           # каждый день в 04:00
